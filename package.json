{
  "name": "dsh-business-cards",
  "version": "0.2.0",
  "description": "DeepSeek Harness 插件：人脉助手——私人商业人脉名片墙，左侧档案 + 右侧 DSH 会话。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlan28/dsh-business-agent.git"
  },
  "homepage": "https://github.com/shlan28/dsh-business-agent#readme",
  "bugs": {
    "url": "https://github.com/shlan28/dsh-business-agent/issues"
  },
  "type": "module",
  "main": "./src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "files": [
    "src",
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "scripts"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "crm",
    "contacts",
    "business-card"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
